<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="SpaceMaster for Windows"
           Manufacturer="cembaylam"
           Version="$(var.Version)"
           UpgradeCode="6B1D0A52-3C47-4E0B-9B6E-5A0F2C9D7E11"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of SpaceMaster for Windows is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cembaylam/SpaceMaster" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SpaceMaster for Windows" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="SpaceMaster for Windows" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\license.rtf" />

    <!-- Offer to start the app on the last dialog. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start SpaceMaster for Windows" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SpaceMasterExe]" />
    <CustomAction Id="LaunchApp" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="SpaceMasterExe" Source="target\release\spacemaster.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SpaceMaster for Windows"
                    Description="Fast disk-space manager" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="no" />
        </File>
      </Component>
      <Component Id="ReadmeComponent">
        <File Id="ReadmeFile" Source="README.md" KeyPath="yes" />
      </Component>
      <Component Id="LicenseComponent">
        <File Id="LicenseFile" Source="LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcutLink" Name="SpaceMaster for Windows" Target="[#SpaceMasterExe]" Icon="AppIcon"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\SpaceMaster for Windows" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
